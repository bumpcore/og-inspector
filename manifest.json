{
  "manifest_version": 3,
  "name": "OG Inspector",
  "version": "0.1.0",
  "description": "See how the current page looks when shared: Open Graph and Twitter card previews, image checks, and raw tags.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect Open Graph",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"]
}
